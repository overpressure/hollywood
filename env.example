# --- Meta Quest 2 (hollywood): python -m overpressure --device hollywood ... ---

# Serials: "adb devices", "fastboot devices", and "Serial Number" in edl-ng's output.
HOLLYWOOD_ADB_SERIAL=
HOLLYWOOD_FASTBOOT_SERIAL=
HOLLYWOOD_EDL_SERIAL=

# The headset's records: its identity and its verified EDL backup.
HOLLYWOOD_IDENTITY=backup/device.json
HOLLYWOOD_BACKUP=backup/stock

# The Firehose loader for EDL. Empty HOLLYWOOD_EDL: the edl-ng that python -m overpressure tools fetches.
HOLLYWOOD_LOADER=assets/firehose.elf
HOLLYWOOD_EDL=

# Your own public key file, enrolled besides this computer's key where the headset takes SSH keys.
HOLLYWOOD_SSH_PUBLIC_KEY=

# Windows: a Python with pyusb and libusb-package for a USB network link. Empty: the Python that runs overpressure.
HOLLYWOOD_NCM_PYTHON=

# Programs: your own adb and fastboot folder (empty: the platform-tools python -m overpressure tools fetches,
# else PATH), ssh and ssh-keygen.
HOLLYWOOD_PLATFORM_TOOLS=
HOLLYWOOD_SSH=ssh
HOLLYWOOD_SSH_KEYGEN=ssh-keygen
